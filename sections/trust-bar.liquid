{% schema %}
{
  "name": "Trust Bar",
  "settings": [
    {
      "type": "text",
      "id": "badge_1_title",
      "label": "Badge 1 - Título",
      "default": "Webpay"
    },
    {
      "type": "text",
      "id": "badge_1_subtitle",
      "label": "Badge 1 - Subtítulo",
      "default": "Pago 100% seguro"
    },
    {
      "type": "text",
      "id": "badge_2_title",
      "label": "Badge 2 - Título",
      "default": "Blue Express"
    },
    {
      "type": "text",
      "id": "badge_2_subtitle",
      "label": "Badge 2 - Subtítulo",
      "default": "Despacho a todo Chile"
    },
    {
      "type": "text",
      "id": "badge_3_title",
      "label": "Badge 3 - Título",
      "default": "Retiro en tienda"
    },
    {
      "type": "text",
      "id": "badge_3_subtitle",
      "label": "Badge 3 - Subtítulo",
      "default": "Gratis y coordinado"
    },
    {
      "type": "text",
      "id": "badge_4_title",
      "label": "Badge 4 - Título",
      "default": "Garantía Täumm"
    },
    {
      "type": "text",
      "id": "badge_4_subtitle",
      "label": "Badge 4 - Subtítulo",
      "default": "Respaldo de marca"
    }
  ]
}
{% endschema %}

<section class="trust-bar">
  <div class="trust-bar__grid container">
    <div class="trust-bar__item">
      <svg class="trust-bar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
      <div>
        <p class="trust-bar__title">{{ section.settings.badge_1_title }}</p>
        <p class="trust-bar__subtitle">{{ section.settings.badge_1_subtitle }}</p>
      </div>
    </div>
    <div class="trust-bar__item">
      <svg class="trust-bar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
      <div>
        <p class="trust-bar__title">{{ section.settings.badge_2_title }}</p>
        <p class="trust-bar__subtitle">{{ section.settings.badge_2_subtitle }}</p>
      </div>
    </div>
    <div class="trust-bar__item">
      <svg class="trust-bar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      <div>
        <p class="trust-bar__title">{{ section.settings.badge_3_title }}</p>
        <p class="trust-bar__subtitle">{{ section.settings.badge_3_subtitle }}</p>
      </div>
    </div>
    <div class="trust-bar__item">
      <svg class="trust-bar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      <div>
        <p class="trust-bar__title">{{ section.settings.badge_4_title }}</p>
        <p class="trust-bar__subtitle">{{ section.settings.badge_4_subtitle }}</p>
      </div>
    </div>
  </div>
</section>
