{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "phone",
      "label": "Teléfono",
      "default": "+56 9 0000 0000"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "ventas@paulahome.cl"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Dirección",
      "default": "Región del Biobío, Chile"
    }
  ]
}
{% endschema %}

<footer class="footer">
  <!-- Trust strip -->
  <div class="footer__trust-strip">
    <div class="footer__trust-grid container">
      <div class="footer__trust-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
        <div>
          <p>Pago seguro Webpay</p>
          <p>Débito, crédito y transferencia</p>
        </div>
      </div>
      <div class="footer__trust-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        <div>
          <p>Despacho Blue Express</p>
          <p>Envíos a todo Chile</p>
        </div>
      </div>
      <div class="footer__trust-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        <div>
          <p>Retiro en tienda</p>
          <p>Coordina y retira gratis</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Footer main -->
  <div class="footer__main container">
    <div>
      <p class="footer__brand-name">{{ shop.name }}</p>
      <p class="footer__brand-description">
        Grifería, sanitarios y accesorios para tu hogar. Calidad Täumm con respaldo y despacho a todo Chile.
      </p>
    </div>

    <div>
      <p class="footer__column-title">Comprar</p>
      <ul class="footer__column-list">
        <li><a href="{{ routes.all_products_collection_url }}">Catálogo completo</a></li>
        <li><a href="/collections/monomandos">Monomandos</a></li>
        <li><a href="/collections/shower-e-hidromasaje">Shower e Hidromasaje</a></li>
        <li><a href="/collections/saldos-ofertas">Ofertas</a></li>
      </ul>
    </div>

    <div>
      <p class="footer__column-title">Ayuda</p>
      <ul class="footer__column-list">
        <li><a href="/pages/retiro">Retiro en tienda</a></li>
        <li>Despacho y envíos</li>
        <li>Cambios y devoluciones</li>
        <li>Preguntas frecuentes</li>
      </ul>
    </div>

    <div>
      <p class="footer__column-title">Contacto</p>
      <ul class="footer__column-list">
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          {{ section.settings.phone }}
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          {{ section.settings.email }}
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          {{ section.settings.address }}
        </li>
      </ul>
    </div>
  </div>

  <!-- Footer bottom -->
  <div class="footer__bottom">
    <div class="footer__bottom-inner container">
      <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}. Todos los derechos reservados.</span>
      <span>Términos · Privacidad</span>
    </div>
  </div>
</footer>
