<div class="cart-drawer__overlay" data-cart-overflow></div>
<aside class="cart-drawer__panel" data-cart-panel role="dialog" aria-label="Carrito de compras">
  <div class="cart-drawer__header">
    <h2>Tu carrito (<span data-cart-panel-count>0</span>)</h2>
    <button class="cart-drawer__close" data-cart-close aria-label="Cerrar">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  <div class="cart-drawer__empty" data-cart-empty>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
    <p>Tu carrito está vacío.</p>
    <button class="cart-drawer__continue-btn" data-cart-close>Seguir comprando</button>
  </div>

  <div class="cart-drawer__items" data-cart-items style="display:none;"></div>

  <div class="cart-drawer__footer" data-cart-footer style="display:none;">
    <div class="cart-drawer__subtotal">
      <span>Subtotal</span>
      <span data-cart-subtotal>$0</span>
    </div>
    <p class="cart-drawer__note">Despacho e impuestos calculados al finalizar la compra.</p>
    <a href="/checkout" class="cart-drawer__checkout-btn">Pagar con Webpay</a>
    <button class="cart-drawer__continue" data-cart-close>Seguir comprando</button>
  </div>
</aside>

<template id="cart-item-template">
  <div class="cart-drawer__item" data-cart-item>
    <div class="cart-drawer__item-info">
      <p class="cart-drawer__item-title" data-item-title></p>
      <p class="cart-drawer__item-sku" data-item-sku></p>
      <div class="cart-drawer__item-qty">
        <div class="cart-drawer__qty-control">
          <button data-qty-dec aria-label="Menos">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </button>
          <span data-qty-value></span>
          <button data-qty-inc aria-label="Más">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </button>
        </div>
        <button class="cart-drawer__item-remove" data-item-remove aria-label="Eliminar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
        </button>
      </div>
    </div>
    <span class="cart-drawer__item-price" data-item-price></span>
  </div>
</template>
