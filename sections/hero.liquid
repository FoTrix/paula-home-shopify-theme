{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Etiqueta superior",
      "default": "Línea Täumm · Chile"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Grifería y baño con carácter."
    },
    {
      "type": "text",
      "id": "title_highlight",
      "label": "Resaltado del título",
      "default": "con carácter."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Descripción",
      "default": "Monomandos, tinas, shower y accesorios para renovar tu hogar. Calidad garantizada, retiro en tienda y despacho a todo Chile."
    },
    {
      "type": "text",
      "id": "cta_primary_text",
      "label": "Texto CTA primario",
      "default": "Explorar catálogo"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "URL CTA primario"
    },
    {
      "type": "text",
      "id": "cta_secondary_text",
      "label": "Texto CTA secundario",
      "default": "Ver ofertas"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "URL CTA secundario"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Imagen hero"
    }
  ]
}
{% endschema %}

<section class="hero">
  <div class="hero__grid container">
    <div class="hero__content">
      <span class="hero__badge">{{ section.settings.badge }}</span>
      <h1 class="hero__title">
        {{ section.settings.title }}
        <br>
        <span>{{ section.settings.title_highlight }}</span>
      </h1>
      <p class="hero__description">{{ section.settings.description }}</p>
      <div class="hero__actions">
        <a href="{{ section.settings.cta_primary_url | default: routes.collections_url }}" class="hero__cta-primary">
          {{ section.settings.cta_primary_text }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href="{{ section.settings.cta_secondary_url | default: '/collections/saldos-ofertas' }}" class="hero__cta-secondary">
          {{ section.settings.cta_secondary_text }}
        </a>
      </div>
      <div class="hero__stats">
        <div>
          <p class="hero__stat-number">{{ collections.all.products_count }}+</p>
          <p class="hero__stat-label">Productos</p>
        </div>
        <div>
          <p class="hero__stat-number">{{ collections.size }}</p>
          <p class="hero__stat-label">Categorías</p>
        </div>
        <div>
          <p class="hero__stat-number">100%</p>
          <p class="hero__stat-label">Pago seguro</p>
        </div>
      </div>
    </div>

    <div class="hero__image-wrapper">
      <div class="hero__image">
        {% if section.settings.hero_image %}
          <img src="{{ section.settings.hero_image | image_url: width: 800 }}" alt="{{ section.settings.title }}" loading="eager" width="800" height="800">
        {% else %}
          <img src="{{ 'hero-main.png' | asset_url }}" alt="{{ section.settings.title }}" loading="eager" width="800" height="800">
        {% endif %}
      </div>
    </div>
  </div>
</section>
