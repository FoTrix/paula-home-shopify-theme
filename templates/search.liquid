{% comment %} Resultados de búsqueda — mismo layout que catálogo {% endcomment %}
<section class="collection-hero">
  <div class="container">
    <nav class="breadcrumb">
      <a href="{{ routes.root_url }}">Inicio</a>
      <span>/</span>
      <span class="breadcrumb__current">Búsqueda</span>
    </nav>
    <div class="collection-hero__row">
      <div>
        <h1 class="collection-hero__title">Resultados para &ldquo;{{ search.terms | escape }}&rdquo;</h1>
        <p class="collection-hero__count" data-search-count>{{ search.results_count }} productos</p>
      </div>
    </div>
  </div>
</section>

<div class="container listing">
  <div class="listing__results">
    {% if search.performed %}
      {% if search.results_count == 0 %}
        <div class="listing__empty">
          <p>No encontramos productos para &ldquo;{{ search.terms | escape }}&rdquo;.</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn-primary">Ver todo el catálogo</a>
        </div>
      {% else %}
        {% paginate search.results by 24 %}
          <div class="featured-products__grid listing__grid" data-search-results>
            {% for item in search.results %}
              {% if item.object_type == 'product' %}
                <div data-sku="{{ item.variants.first.sku | escape }}">
                  {% render 'product-card', product: item %}
                </div>
              {% endif %}
            {% endfor %}
          </div>
          {% if paginate.pages > 1 %}
            <div class="pagination">
              {% if paginate.previous %}<a href="{{ paginate.previous.url }}" class="pagination__btn">&lsaquo;</a>{% endif %}
              <span class="pagination__label">Página {{ paginate.current_page }} de {{ paginate.pages }}</span>
              {% if paginate.next %}<a href="{{ paginate.next.url }}" class="pagination__btn">&rsaquo;</a>{% endif %}
            </div>
          {% endif %}
        {% endpaginate %}
      {% endif %}
    {% endif %}
  </div>
</div>

<script>
(function () {
  var query = {{ search.terms | json }}.toLowerCase();
  if (!query) return;
  if (!/^\d/.test(query)) return;
  /* SKU filter: hide non-matching cards if query looks like a SKU */
  var cards = document.querySelectorAll('[data-sku]');
  var visible = 0;
  cards.forEach(function (card) {
    var sku = (card.getAttribute('data-sku') || '').toLowerCase();
    if (sku && sku.indexOf(query) !== -1) {
      card.style.display = '';
      visible++;
    } else {
      card.style.display = 'none';
    }
  });
  var countEl = document.querySelector('[data-search-count]');
  if (countEl) countEl.textContent = visible + ' producto' + (visible !== 1 ? 's' : '');
})();
</script>
