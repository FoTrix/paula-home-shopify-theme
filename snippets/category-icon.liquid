{% comment %}
  category-icon.liquid
  Renders a category card with icon, name, and product count.
  Params:
    - icon: lucide icon name (string, default: 'Package')
    - name: category display name
    - count: product count
    - url: collection URL
    - delay: animation delay in ms
{% endcomment %}

{% assign delay = delay | default: 0 %}

<a href="{{ url }}" class="categories__card" style="animation-delay: {{ delay }}ms;">
  <span class="categories__card-icon">
    {% render 'icon', icon_name: icon %}
  </span>
  <div style="min-width: 0;">
    <p class="categories__card-name">{{ name }}</p>
    <p class="categories__card-count">{{ count }} productos</p>
  </div>
</a>
