{% comment %}
  product-card.liquid
  Tarjeta de producto con visual placeholder (gradiente + icono).
  Parámetros:
    - product: objeto producto de Shopify
{% endcomment %}

{% assign product = product %}

{% comment %} Determinar gradiente basado en SKU {% endcomment %}
{% assign sku_chars = product.variants.first.sku | default: product.title %}
{% assign tone_index = 0 %}
{% for char in sku_chars %}
  {% assign tone_index = tone_index | plus: 1 %}
{% endfor %}
{% assign tone_mod = tone_index | modulo: 4 %}

{% case tone_mod %}
  {% when 0 %}{% assign gradient_from = '#efe7db' %}{% assign gradient_to = '#e3d5c4' %}
  {% when 1 %}{% assign gradient_from = '#eee6dc' %}{% assign gradient_to = '#ddcdb9' %}
  {% when 2 %}{% assign gradient_from = '#f0ece4' %}{% assign gradient_to = '#e0d3c2' %}
  {% when 3 %}{% assign gradient_from = '#ece3d6' %}{% assign gradient_to = '#d9c8b4' %}
{% endcase %}

{% comment %} Icono por categoría (usando tags como fallback) {% endcomment %}
{% assign cat_icon = 'Package' %}
{% for tag in product.tags %}
  {% if tag contains 'icon-' %}
    {% assign cat_icon = tag | remove: 'icon-' %}
    {% break %}
  {% endif %}
{% endfor %}

<article class="product-card" style="animation-delay: {{ forloop.index | times: 40 }}ms;">
  <a href="{{ product.url }}" class="product-card__image-wrapper">
    <div class="product-card__image product-card__image-bg" style="background: linear-gradient(135deg, {{ gradient_from }}, {{ gradient_to }});">
      {% if product.featured_image %}
        <img
          src="{{ product.featured_image | image_url: width: 400 }}"
          alt="{{ product.featured_image.alt | default: product.title | escape }}"
          class="product-card__img"
          loading="lazy"
          width="{{ product.featured_image.width }}"
          height="{{ product.featured_image.height }}"
        >
      {% else %}
        {% case cat_icon %}
          {% when 'Droplet' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
          {% when 'Droplets' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M7 16.3c2.2 0 4-1.83 4-4.05 0-1.16-.57-2.26-1.71-3.19S7.29 6.75 7 5.3c-.29 1.45-1.14 2.84-2.29 3.76S3 11.1 3 12.25c0 2.22 1.8 4.05 4 4.05z"/></svg>
          {% when 'ShowerHead' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16"/><path d="M6 4v16"/><path d="M18 4v16"/></svg>
          {% when 'Bath' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 6 6.5 3.5a1.5 1.5 0 0 0-1-.5C4.683 3 4 3.684 4 4.515V13"/><path d="M5 13v5a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-5"/></svg>
          {% when 'Wrench' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          {% when 'Cog' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          {% when 'Tag' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
          {% when 'Toilet' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 6h.5A2.5 2.5 0 0 1 19 8.5V10"/><path d="M3 10h18v4a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4v-4z"/></svg>
          {% when 'Zap' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          {% when 'Layers' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/></svg>
          {% when 'Flame' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>
          {% when 'UtensilsCrossed' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 15 3.3 3.3a4.2 4.2 0 0 0 0 6l7.3 7.3c.7.7 2 .7 2.8 0L15 15Zm0 0 7 7"/></svg>
          {% when 'Cable' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 9a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V9z"/><path d="M8 9v6"/><path d="M16 9v6"/></svg>
          {% when 'Gauge' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 16v-4"/><path d="M12 22C6.5 22 2 17.5 2 12S6.5 2 12 2s10 4.5 10 10-4.5 10-10 10z"/></svg>
          {% when 'Timer' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="14" r="8"/><line x1="12" y1="10" x2="12" y2="14"/><line x1="10" y1="2" x2="14" y2="2"/></svg>
          {% when 'KeyRound' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 18v3c0 .6.4 1 1 1h4v-3h3v-3h2l1.4-1.4a6.5 6.5 0 1 0-4-4Z"/><circle cx="16.5" cy="7.5" r=".5"/></svg>
          {% else %}
            {% comment %}Default: Package{% endcomment %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="16.5" y1="9.4" x2="7.5" y2="4.21"/><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
        {% endcase %}
      {% endif %}
      <div class="product-card__image-overlay"></div>
    </div>
    {% if product.tags contains 'oferta' or product.tags contains 'sale' or product.compare_at_price > product.price %}
      <span class="product-card__category-tag" style="color: var(--sale); background: rgba(255,255,255,0.9);">Oferta</span>
    {% elsif product.type != blank %}
      <span class="product-card__category-tag">{{ product.type }}</span>
    {% else %}
      <span class="product-card__category-tag">{{ cat_icon }}</span>
    {% endif %}
  </a>

  <div class="product-card__info">
    <a href="{{ product.url }}">
      <h3 class="product-card__title">{{ product.title }}</h3>
    </a>
    {% if product.variants.first.sku %}
      <p class="product-card__sku">SKU {{ product.variants.first.sku }}</p>
    {% endif %}
    <div class="product-card__bottom">
      <span class="product-card__price">{{ product.price | money }}</span>
      <button
        type="button"
        class="product-card__add-btn"
        data-add-to-cart
        data-variant-id="{{ product.variants.first.id }}"
        aria-label="Agregar al carrito"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      </button>
    </div>
  </div>
</article>
